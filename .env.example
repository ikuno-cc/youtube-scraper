# ── Cookies ────────────────────────────────────────────────────────────────────
# Path to Netscape-format YouTube cookies file for yt-dlp authentication.
# Required for videos/channels that need login ("Sign in to confirm you're not a bot").
# Update this file on the host — no Docker rebuild needed (it's a volume mount).
COOKIES_FILE=/app/cookies/cookies.txt

# ── Cache ──────────────────────────────────────────────────────────────────────
# How long to cache responses (seconds). Default: 300 (5 minutes)
CACHE_TTL_SECONDS=300

# Max number of cached responses to keep in memory. Default: 500
CACHE_MAX_SIZE=500

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Max requests per minute per IP address. Default: 30
RATE_LIMIT_PER_MINUTE=30

# ── Scraping ───────────────────────────────────────────────────────────────────
# Max results returned from search and channel endpoints. Default: 20
MAX_RESULTS=20

# Suppress yt-dlp output in logs. Default: true
YT_DLP_QUIET=true

# ── Server ─────────────────────────────────────────────────────────────────────
# Port to listen on. Default: 8000
PORT=8000

# Enable Swagger /docs and /redoc. Default: true
# Set to false to hide the API explorer in production
DOCS_ENABLED=true

# CORS allowed origins (comma-separated). Default: * (all)
# Example: https://myapp.example.com,https://myother.app
CORS_ORIGINS=*
